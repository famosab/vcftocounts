/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    withName: GATK4_GENOTYPEGVCFS {
        ext.prefix = { "${meta.name}.normal" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/gvcftovcf/${meta.label}/" },
        ]
    }

    withName: BEFORE_FILTER_STATS {
        ext.prefix = { "${meta.name}" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/stats/${meta.label}/" },
        ]
    }

    withName: BCFTOOLS_VIEW {
        ext.prefix = { "${meta.name}.filter" }
        ext.args   = { "--output-type z --write-index=tbi -i '${params.filter}'" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/view/${meta.label}/" },
        ]
    }

    withName: AFTER_FILTER_STATS {
        ext.prefix = { "${meta.name}.filter" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/stats/${meta.label}/" },
        ]
    }

    withName: BCFTOOLS_CONCAT {
        ext.prefix = { "${meta.id}.${meta.label}.concat" }
        ext.args   = { " --allow-overlaps --output-type z --write-index=tbi" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/concat/" },
        ]
    }

    withName: CREATE_SAMPLE_FILE {
        ext.prefix = { "${meta.label}" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/reheader/samplefiles/" },
        ]
    }

    withName: BCFTOOLS_REHEADER {
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'terminate' }
        maxRetries    = 3
        ext.prefix    = { "${meta.id}.${meta.label}.reheader" }
        ext.args2     = { "--output-type z --write-index=tbi" }
        publishDir    = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/reheader/${meta.id}/" },
        ]
    }

    withName: BCFTOOLS_MERGE {
        ext.args   = { "--force-samples --output-type z --write-index=tbi" }
        ext.prefix = { "${meta.id}.merge" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/merge/" },
        ]
    }

    withName: BCFTOOLS_ANNOTATE {
        ext.args   = { "-x ID --output-type z --write-index=tbi" }
        ext.prefix = { "${meta.id}.IDremoved" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/bcftools/annotate/" },
        ]
    }

    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // The diversity step is the pipeline's memory bottleneck. hill.R forks
    // workers (copy-on-write on the count table) when --parallel is left at its
    // 'auto' default, but each worker still allocates its own resampled subsets
    // and hillR intermediates, so cores must stay modest and numvariants must be
    // capped while a single table stands in for both arms. See hill_max_variants
    // in nextflow.config for why the cap exists and when to remove it.
    withName: DIVANALYSIS_HILL {
        cpus     = { params.hill_cores }
        ext.args = { "--max-variants ${params.hill_max_variants}" }
    }
}
